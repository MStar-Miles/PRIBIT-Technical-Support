# To configure generic OIDC auth, you'll need some kind of identity provider.
# See documentation for whichever IdP you use to acquire the following info:
# Redirect URI is https://<URL>/auth/oidc.callback
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=bNBoWbERolhvf77mMlhbwaiDJwdKxPKr
OIDC_AUTH_URI=https://idp.tech-packetgo.com/realms/outline/protocol/openid-connect/auth
OIDC_TOKEN_URI=https://idp.tech-packetgo.com/realms/outline/protocol/openid-connect/token
OIDC_USERINFO_URI=https://idp.tech-packetgo.com/realms/outline/protocol/openid-connect/userinfo
OIDC_LOGOUT_URI=https://idp.tech-packetgo.com/realms/outline/protocol/openid-connect/logout

# Specify which claims to derive user information from
# Supports any valid JSON path with the JWT payload
OIDC_USERNAME_CLAIM=preferred_username

# Display name for OIDC authentication
OIDC_DISPLAY_NAME=PRIIBT TECH

# Space separated auth scopes.
OIDC_SCOPES=openid profile email

